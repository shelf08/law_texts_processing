    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_декабря"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_лишением"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_свободы"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#УК_РФ_article_152">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>152</law:hasNumber>
    <law:hasText xml:lang="ru">Утратила силу. - Федеральныйзакон от 08.12.2003 N 162-ФЗ.</law:hasText>
    <law:hasPage>84</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#УК_РФ"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#Ugolovnyy_kodex_Rossiyskoy_Federatsii_article_155">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>155</law:hasNumber>
    <law:hasText xml:lang="ru">Разглашение тайны усыновления (удочерения)
Разглашение тайны усыновления (удочерения) вопреки воле усыновителя, совершенное лицом, обязанным
хранить факт усыновления (удочерения) как служебную или профессиональную тайну, либо иным лицом из
корыстных или иных низменных побуждений, -
наказывается штрафом в размере до восьмидесяти тысяч рублей или в размере заработной платы или
иного дохода осужденного за период до шести месяцев, либо обязательными работами на срок до трехсот
шестидесяти часов, либо исправительными работами на срок до одного года, либо арестом на срок до четырех
месяцев с лишением права занимать определенные должности или заниматься определенной деятельностью
на срок до трех лет или без такового.
(Абзац в редакции, введенной в действие с 11 декабря 2003 года Федеральным законом от 8 декабря
2003 года N 162-ФЗ; дополнен с 11 мая 2010 года Федеральным законом от 6 мая 2010 года N 81-ФЗ; в
редакции, введенной в действие с 8 декабря 2011 года Федеральным законом от 7 декабря 2011 года N 420-
Внимание! Документ с изменениями и дополнениями (новая редакция). О последующих изменениях см. ярлык "Оперативная информация"
ИС «Техэксперт: 6 поколение» Интранет
Уголовный кодекс Российской Федерации (с изменениями на 31 июля 2025 года) (редакция, действующая с 1 сентября 2025 Страница 111
года)
Кодекс РФ от 13.06.1996 N 63-ФЗ
ФЗ. - См. предыдущую редакцию)

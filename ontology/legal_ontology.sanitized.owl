    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_гарант"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_2026"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_договора"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#УК_РФ_article_72">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>72</law:hasNumber>
    <law:hasText xml:lang="ru">Исчисление сроков наказаний и зачет наказания
1. Сроки лишения права занимать определенные должности или заниматься определенной
деятельностью, исправительных работ, ограничения по военной службе, ограничения свободы,
принудительных работ, ареста, содержания в дисциплинарной воинской части, лишения свободы
КонсультантПлюс

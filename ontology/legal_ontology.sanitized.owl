    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_может"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_права"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_701">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>701</law:hasNumber>
    <law:hasText xml:lang="ru">Прекращение договора безвозмездного пользования
Договор безвозмездного пользования прекращается в случае смерти гражданина-
ссудополучателя или ликвидации юридического лица - ссудополучателя, если иное не
предусмотрено договором.

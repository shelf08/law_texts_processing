    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_лишением"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_действие"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_625">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>625</law:hasNumber>
    <law:hasText xml:lang="ru">Особенности отдельных видов аренды и аренды отдельных видов имущества
К отдельным видам договора аренды и договорам аренды отдельных видов имущества
(прокат, аренда транспортных средств, аренда зданий и сооружений, аренда предприятий,
финансовая аренда) положения, предусмотренные настоящим параграфом, применяются, если иное
не установлено правилами настоящего Кодекса об этих договорах.

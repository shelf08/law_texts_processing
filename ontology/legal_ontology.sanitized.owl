  <rdf:Description rdf:about="http://law.ontology.ru/#ГК_РФ_article_311">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>311</law:hasNumber>
    <law:hasText xml:lang="ru">Исполнение обязательства по частям
Кредитор вправе не принимать исполнения обязательства по частям, если иное не предусмотрено
законом, иными правовыми актами, условиями обязательства и не вытекает из обычаев или существа
обязательства.
(в ред. Федеральногозакона от 08.03.2015 N 42-ФЗ)</law:hasText>
    <law:hasPage>171</law:hasPage>

    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договора"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_быть"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_может"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_права"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_договором"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#ГК_РФ_article_147">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>147</law:hasNumber>
    <law:hasText xml:lang="ru">Ответственность за действительность прав, удостоверенных документарной
ценной бумагой
1. Лицо, передавшее документарную ценную бумагу, несет ответственность за недействительность
прав, удостоверенных ценной бумагой, если иное не установлено законом.
Лицо, передавшее документарную ценную бумагу, несет ответственность за исполнение
КонсультантПлюс
www.consultant.ru Страница 97 из 244
надежная правовая поддержка
"Гражданский кодекс Российской Федерации (часть

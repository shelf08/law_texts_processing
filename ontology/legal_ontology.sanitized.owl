утрачивает ценность для ссудополучателя, последний вправе потребовать предоставления ему
таких принадлежностей и документов либо расторжения договора и возмещения понесенного им
реального ущерба.</law:hasText>
    <law:hasPage>268</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>

    <law:hasNumber>501</law:hasNumber>
    <law:hasText xml:lang="ru">Договор найма-продажи
Договором может быть предусмотрено, что до перехода права собственности на товар к
покупателю (</law:hasText>
    <law:hasPage>224</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>

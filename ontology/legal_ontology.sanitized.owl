  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_1098">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>1098</law:hasNumber>
    <law:hasText xml:lang="ru">Основания освобождения от ответственности за вред, причиненный
вследствие недостатков товара, работы или услуги
Продавец или изготовитель товара, исполнитель работы или услуги освобождается от
ответственности в случае, если докажет, что вред возник вследствие непреодолимой силы или
нарушения потребителем установленных правил пользования товаром, результатами работы, услуги
или их хранения.
§ 4. Компенсация морального вреда</law:hasText>
    <law:hasPage>385</law:hasPage>

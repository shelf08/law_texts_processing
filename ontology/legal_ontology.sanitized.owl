    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_законом"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договором"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_570">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>570</law:hasNumber>
    <law:hasText xml:lang="ru">Переход права собственности на обмениваемые товары
Если законом или договором мены не предусмотрено иное, право собственности на
обмениваемые товары переходит к сторонам, выступающим по договору мены в качестве
покупателей, одновременно после исполнения обязательств передать соответствующие товары
обеими сторонами.</law:hasText>
    <law:hasPage>242</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>

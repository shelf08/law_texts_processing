  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_309.2">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>309.2</law:hasNumber>
    <law:hasText xml:lang="ru">Расходы на исполнение обязательства
Должник несет расходы на исполнение обязательства, если иное не предусмотрено законом,
иными правовыми актами или договором либо не вытекает из существа обязательства, обычаев или
других обычно предъявляемых требований.</law:hasText>
    <law:hasPage>147</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>

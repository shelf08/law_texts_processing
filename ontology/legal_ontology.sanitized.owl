    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договором"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_может"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_договора"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#ГК_РФ_article_358.11">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>358.11</law:hasNumber>
    <law:hasText xml:lang="ru">Возникновение залога прав по договору банковского счета
(в ред. Федеральногозакона от 21.12.2013 N 367-ФЗ)
Залог на основании договора залога прав по договору банковского счета возникает с момента
уведомления банка о залоге прав и предоставления ему копии договора залога. В случае, если
залогодержателем является банк, заключивший с клиентом (залогодателем) договор залогового счета,
КонсультантПлюс
www.consultant.ru Страница 200 из 244
надежная правовая поддержка
"Гражданский кодекс Российской Федерации (часть
Документ предоставленКонсультантПлюс
первая)" от 30.11.1994 N 51-ФЗ
Дата сохранения: 16.08.2024
(ред. от 08.08.2024)
залог возникает с момента заключения договора залога прав по банковскому счету.</law:hasText>
    <law:hasPage>201</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#ГК_РФ"/>

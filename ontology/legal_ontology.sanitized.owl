    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договор"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_закон"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_1286.1">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>1286.1</law:hasNumber>
    <law:hasText xml:lang="ru">).</law:hasText>

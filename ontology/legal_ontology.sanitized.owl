    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>269</law:hasNumber>
    <law:hasText xml:lang="ru">Нарушение правил безопасности при строительстве, эксплуатации или ремонте
магистральных трубопроводов
(Утратила силу с 21 октября 2018 года - Федеральный закон от 23 апреля 2018 года N 114-ФЗ. - См.
предыдущую редакцию)
Комментарий к статье 269</law:hasText>

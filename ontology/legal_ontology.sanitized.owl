    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#УК_РФ"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_срок"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_либо"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_размер"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_лишение"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#Ugolovnyy_kodex_Rossiyskoy_Federatsii_article_44">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>44</law:hasNumber>
    <law:hasText xml:lang="ru">Виды наказаний
Видами наказаний являются:
а) штраф;
б) лишение права занимать определенные должности или заниматься определенной деятельностью;
в) лишение специального, воинского или почетного звания, классного чина и государственных наград;
г) обязательные работы;
д) исправительные работы;
е) ограничение по военной службе;
ж) пункт утратил силу с 11 декабря 2003 года - Федеральный закон от 8 декабря 2003 года N 162-ФЗ - см.
предыдущую редакцию;
з) ограничение свободы;
з_1) принудительные работы;
(Пункт дополнительно включен с 8 декабря 2011 года Федеральным законом от 7 декабря 2011 года N
420-ФЗ)
и) арест;
к) содержание в дисциплинарной воинской части;
л) лишение свободы на определенный срок;
м) пожизненное лишение свободы;
н) смертная казнь.
Комментарий к статье 44</law:hasText>
    <law:hasPage>25</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#Ugolovnyy_kodex_Rossiyskoy_Federatsii"/>

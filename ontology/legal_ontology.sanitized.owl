  <rdf:Description rdf:about="http://law.ontology.ru/#Конституция_РФ_article_122">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>122</law:hasNumber>
    <law:hasText xml:lang="ru">1. Судьи неприкосновенны.
2. Судья не может быть привлечен к уголовной ответственности иначе как в порядке,
определяемом федеральным законом.</law:hasText>
    <law:hasPage>48</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#Конституция_РФ"/>

    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_если"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договора"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_гарант"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_2026"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_договором"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#ГК_РФ_article_106.4">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>106.4</law:hasNumber>
    <law:hasText xml:lang="ru">Особенности управления в производственном кооперативе
1. Исполнительными органами производственного кооператива являются председатель и правление
кооператива, если его образование предусмотренозаконом или уставом кооператива.
2. Членами правления производственного кооператива и председателем кооператива могут быть
только члены кооператива.
3. Член производственного кооператива имеет один голос при принятии решений общим собранием.</law:hasText>
    <law:hasPage>67</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#ГК_РФ"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_если"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_закон"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_1011">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>1011</law:hasNumber>
    <law:hasText xml:lang="ru">Применение к агентским отношениям правил о договорах поручения и
комиссии
К отношениям, вытекающим из агентского договора, соответственно применяются правила,
предусмотренные главой 49 или главой 51 настоящего Кодекса, в зависимости от того, действует
агент по условиям этого договора от имени принципала или от своего имени, если эти правила не
противоречат положениям настоящей главы или существу агентского договора.
© ООО "НПП "ГАРАНТ-СЕРВИС-УНИВЕРСИТЕТ", 2026.

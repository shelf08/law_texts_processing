    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_гарант"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_2026"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#ГК_РФ_article_392">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>392</law:hasNumber>
    <law:hasText xml:lang="ru">Возражения нового должника против требования кредитора
Новый должник вправе выдвигать против требования кредитора возражения, основанные на
отношениях между кредитором и первоначальным должником, но не вправе осуществлять в отношении
кредитора право на зачет встречного требования, принадлежащего первоначальному должнику.
КонсультантПлюс

лет, либо обязательными работами на срок до трехсот шестидесяти часов с лишением права занимать
определенные должности или заниматься определенной деятельностью на срок до трех лет.</law:hasText>
    <law:hasPage>98</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#УК_РФ"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_срок"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_либо"/>

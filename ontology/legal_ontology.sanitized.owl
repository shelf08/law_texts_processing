    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_законом"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_196">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>196</law:hasNumber>
    <law:hasText xml:lang="ru">Общий срок исковой давности
1. Общий срок исковой давности составляет три года со дня, определяемого в соответствии
со статьей 200 настоящего Кодекса.
2. Срок исковой давности не может превышать десять лет со дня нарушения права, для
защиты которого этот срок установлен, за исключением случаев, установленных Федеральным
законом от 6 марта 2006 года N 35-ФЗ "О противодействии терроризму".</law:hasText>
    <law:hasText xml:lang="ru">).</law:hasText>
    <law:hasPage>109</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>

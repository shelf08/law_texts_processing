    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_декабря"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_лишением"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_свободы"/>

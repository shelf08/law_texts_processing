    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_законом"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_договором"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_812">
    <rdf:type rdf:resource="http://law.ontology.ru/#Article"/>
    <law:hasNumber>812</law:hasNumber>
    <law:hasText xml:lang="ru">Оспаривание займа по безденежности
1. Заемщик вправе доказывать, что предмет договора займа в действительности не поступил
в его распоряжение или поступил не полностью (оспаривание займа по безденежности).
2. Если договор займа должен быть совершен в письменной форме (</law:hasText>
    <law:hasPage>298</law:hasPage>
    <law:belongsToLaw rdf:resource="http://law.ontology.ru/#garant_grajdansky_kodeks_rf"/>
    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_если"/>

    <law:usesTerm rdf:resource="http://law.ontology.ru/#term_закон"/>
    <law:definesTerm rdf:resource="http://law.ontology.ru/#term_имущество"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://law.ontology.ru/#garant_grajdansky_kodeks_rf_article_1513">
